[Unit]
Description=Ripple personal memory app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ripple
Group=ripple
WorkingDirectory=/opt/ripple/app
Environment=NODE_ENV=production
Environment=PATH=/opt/ripple/runtime/bin:/usr/bin:/bin
Environment=HOST=127.0.0.1
Environment=PORT=4317
Environment=DATA_DIR=/var/lib/ripple
Environment=MODEL_CACHE_DIR=/var/lib/ripple/models
Environment=ALLOWED_HOSTS=ripple.example.com
Environment=AUTH_CONFIG_FILE=/etc/ripple/auth.json
ExecStart=/opt/ripple/runtime/bin/node server/index.mjs --production
Restart=on-failure
RestartSec=5
StateDirectory=ripple
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ripple
Nice=10
CPUQuota=80%
MemoryMax=1300M
MemorySwapMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
